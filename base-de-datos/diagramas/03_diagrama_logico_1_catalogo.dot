digraph logico {
  graph [fontname="Liberation Sans", fontsize=13, bgcolor="white", color="black", fontcolor="black", pad=0.2];
  node  [fontname="Liberation Sans", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Liberation Sans", fontsize=10, color="black", fontcolor="black"];

  graph [rankdir=LR, splines=polyline, nodesep=0.35, ranksep=0.9];
  FAMILIA [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>FAMILIA</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_familia</B></TD><TD ALIGN="LEFT">SMALLINT</TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT"><B>nombre</B></TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR></TABLE>>];
  UBICACION [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>UBICACION</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_ubicacion</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT"><B>clave</B></TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>pasillo</B></TD><TD ALIGN="LEFT">CHAR(1)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">anaquel</TD><TD ALIGN="LEFT">TINYINT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">nivel</TD><TD ALIGN="LEFT">TINYINT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>disponible</B></TD><TD ALIGN="LEFT">BIT</TD></TR></TABLE>>];
  PRODUCTO [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>PRODUCTO</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_producto</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT"><B>codigo_interno</B></TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">codigo_barras</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>descripcion</B></TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT"><B>id_familia</B></TD><TD ALIGN="LEFT">SMALLINT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>unidad_medida</B></TD><TD ALIGN="LEFT">VARCHAR(5)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>minimo</B></TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>maximo</B></TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>punto_reorden</B></TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>existencia</B></TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>costo_unitario</B></TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>precio_venta</B></TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">imagen_url</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_ubicacion</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>activo</B></TD><TD ALIGN="LEFT">BIT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>fecha_alta</B></TD><TD ALIGN="LEFT">DATE</TD></TR></TABLE>>];
  FAMILIA -> PRODUCTO [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_familia ", fontsize=9];
  UBICACION -> PRODUCTO [dir=both, arrowhead=crowodot, arrowtail=teeodot, arrowsize=1.0, label=" id_ubicacion ", fontsize=9];
}