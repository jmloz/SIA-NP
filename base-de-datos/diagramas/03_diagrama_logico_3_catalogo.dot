digraph logico {
  graph [fontname="Liberation Sans", fontsize=13, bgcolor="white", color="black", fontcolor="black", pad=0.2];
  node  [fontname="Liberation Sans", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Liberation Sans", fontsize=10, color="black", fontcolor="black"];

  graph [rankdir=LR, splines=polyline, nodesep=0.35, ranksep=0.9];
  ROL [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>ROL</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_rol</B></TD><TD ALIGN="LEFT">TINYINT</TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT"><B>clave</B></TD><TD ALIGN="LEFT">CHAR(1)</TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT"><B>nombre</B></TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR></TABLE>>];
  USUARIO [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>USUARIO</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT"><B>nombre_usuario</B></TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>password_hash</B></TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>nombre_completo</B></TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">correo</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT"><B>id_rol</B></TD><TD ALIGN="LEFT">TINYINT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>activo</B></TD><TD ALIGN="LEFT">BIT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>intentos_fallidos</B></TD><TD ALIGN="LEFT">TINYINT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>fecha_alta</B></TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ultimo_acceso</TD><TD ALIGN="LEFT">DATETIME2(0)</TD></TR></TABLE>>];
  BITACORA_AUDITORIA [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>BITACORA_AUDITORIA</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_registro</B></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>fecha_hora</B></TD><TD ALIGN="LEFT">DATETIME2(0)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>accion</B></TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>modulo</B></TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">tabla_afectada</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">id_afectado</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">detalle</TD><TD ALIGN="LEFT">VARCHAR(300)</TD></TR></TABLE>>];
  USUARIO -> BITACORA_AUDITORIA [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_usuario ", fontsize=9];
  ROL -> USUARIO [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_rol ", fontsize=9];
}