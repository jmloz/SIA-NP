graph mer {
  graph [fontname="Liberation Sans", fontsize=13, bgcolor="white", color="black", fontcolor="black", pad=0.2];
  node  [fontname="Liberation Sans", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Liberation Sans", fontsize=10, color="black", fontcolor="black"];

  graph [rankdir=TB, splines=true, nodesep=0.1, ranksep=0.3];
  node [fontsize=12];
  FAMILIA [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>FAMILIA</B>>, margin="0.1,0.06"];
  UBICACION [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>UBICACION</B>>, margin="0.1,0.06"];
  PRODUCTO [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>PRODUCTO</B>>, margin="0.1,0.06"];
  PROVEEDOR [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>PROVEEDOR</B>>, margin="0.1,0.06"];
  ORDEN_COMPRA [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>ORDEN_COMPRA</B>>, margin="0.1,0.06"];
  INVENTARIO_FISICO [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>INVENTARIO_FISICO</B>>, margin="0.1,0.06"];
  DETALLE_CONTEO [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>DETALLE_CONTEO</B>>, margin="0.1,0.06", peripheries=2];
  MOVIMIENTO [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>MOVIMIENTO</B>>, margin="0.1,0.06"];
  a1 [shape=ellipse, label=<<U>id_familia</U>>, margin="0.01,0.0", height=0.28];
  FAMILIA -- a1;
  a2 [shape=ellipse, label=<nombre>, margin="0.01,0.0", height=0.28];
  FAMILIA -- a2;
  a3 [shape=ellipse, label=<<U>id_ubicacion</U>>, margin="0.01,0.0", height=0.28];
  UBICACION -- a3;
  a4 [shape=ellipse, label=<pasillo>, margin="0.01,0.0", height=0.28];
  UBICACION -- a4;
  a5 [shape=ellipse, label=<anaquel>, margin="0.01,0.0", height=0.28];
  UBICACION -- a5;
  a6 [shape=ellipse, label=<nivel>, margin="0.01,0.0", height=0.28];
  UBICACION -- a6;
  a7 [shape=ellipse, label=<<U>id_producto</U>>, margin="0.01,0.0", height=0.28];
  PRODUCTO -- a7;
  a8 [shape=ellipse, label=<codigo_interno>, margin="0.01,0.0", height=0.28];
  PRODUCTO -- a8;
  a9 [shape=ellipse, label=<descripcion>, margin="0.01,0.0", height=0.28];
  PRODUCTO -- a9;
  a10 [shape=ellipse, label=<existencia>, margin="0.01,0.0", height=0.28];
  PRODUCTO -- a10;
  a11 [shape=diamond, label="clasifica", margin="0.0,0.0", height=0.45];
  FAMILIA -- a11 [label="1", fontsize=12];
  a11 -- PRODUCTO [label="N", fontsize=12];
  a12 [shape=diamond, label="abarca", margin="0.0,0.0", height=0.45];
  FAMILIA -- a12 [label="1", fontsize=12];
  a12 -- INVENTARIO_FISICO [label="N", fontsize=12];
  a13 [shape=diamond, label="contiene", margin="0.0,0.0", height=0.45];
  UBICACION -- a13 [label="1", fontsize=12];
  a13 -- PRODUCTO [label="N", fontsize=12];
  a14 [shape=diamond, label="ocurre en", margin="0.0,0.0", height=0.45];
  UBICACION -- a14 [label="1", fontsize=12];
  a14 -- MOVIMIENTO [label="N", fontsize=12];
  a15 [shape=diamond, label="afecta", margin="0.0,0.0", height=0.45];
  PRODUCTO -- a15 [label="1", fontsize=12];
  a15 -- MOVIMIENTO [label="N", fontsize=12];
  a16 [shape=diamond, label="surte", margin="0.0,0.0", height=0.45];
  PROVEEDOR -- a16 [label="M", fontsize=12];
  a16 -- PRODUCTO [label="N", fontsize=12];
  a17 [shape=ellipse, label="codigo_proveedor", margin="0.01,0.0", height=0.28];
  a16 -- a17;
  a18 [shape=ellipse, label="precio_compra", margin="0.01,0.0", height=0.28];
  a16 -- a18;
  a19 [shape=ellipse, label="moneda", margin="0.01,0.0", height=0.28];
  a16 -- a19;
  a20 [shape=diamond, label="solicita", margin="0.0,0.0", height=0.45];
  ORDEN_COMPRA -- a20 [label="M", fontsize=12];
  a20 -- PRODUCTO [label="N", fontsize=12];
  a21 [shape=ellipse, label="cantidad_solicitada", margin="0.01,0.0", height=0.28];
  a20 -- a21;
  a22 [shape=ellipse, label="cantidad_recibida", margin="0.01,0.0", height=0.28];
  a20 -- a22;
  a23 [shape=ellipse, label="costo_unitario", margin="0.01,0.0", height=0.28];
  a20 -- a23;
  a24 [shape=diamond, label="se cuenta en", margin="0.0,0.0", height=0.45, peripheries=2];
  PRODUCTO -- a24 [label="1", fontsize=12];
  a24 -- DETALLE_CONTEO [label="N", fontsize=12];
  a25 [shape=diamond, label="se verifica en", margin="0.0,0.0", height=0.45];
  UBICACION -- a25 [label="1", fontsize=12];
  a25 -- DETALLE_CONTEO [label="N", fontsize=12];
}