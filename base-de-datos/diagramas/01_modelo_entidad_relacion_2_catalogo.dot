graph mer {
  graph [fontname="Liberation Sans", fontsize=13, bgcolor="white", color="black", fontcolor="black", pad=0.2];
  node  [fontname="Liberation Sans", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Liberation Sans", fontsize=10, color="black", fontcolor="black"];

  graph [rankdir=TB, splines=true, nodesep=0.1, ranksep=0.3];
  node [fontsize=12];
  USUARIO [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>USUARIO</B>>, margin="0.1,0.06"];
  PRODUCTO [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>PRODUCTO</B>>, margin="0.1,0.06"];
  PROVEEDOR [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>PROVEEDOR</B>>, margin="0.1,0.06"];
  ORDEN_COMPRA [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>ORDEN_COMPRA</B>>, margin="0.1,0.06"];
  RECEPCION [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>RECEPCION</B>>, margin="0.1,0.06"];
  a1 [shape=ellipse, label=<<U>id_proveedor</U>>, margin="0.01,0.0", height=0.28];
  PROVEEDOR -- a1;
  a2 [shape=ellipse, label=<rfc>, margin="0.01,0.0", height=0.28];
  PROVEEDOR -- a2;
  a3 [shape=ellipse, label=<razon_social>, margin="0.01,0.0", height=0.28];
  PROVEEDOR -- a3;
  a4 [shape=ellipse, label=<<U>id_oc</U>>, margin="0.01,0.0", height=0.28];
  ORDEN_COMPRA -- a4;
  a5 [shape=ellipse, label=<folio>, margin="0.01,0.0", height=0.28];
  ORDEN_COMPRA -- a5;
  a6 [shape=ellipse, label=<estado>, margin="0.01,0.0", height=0.28];
  ORDEN_COMPRA -- a6;
  a7 [shape=ellipse, label=<total>, margin="0.01,0.0", height=0.28, style=dashed];
  ORDEN_COMPRA -- a7;
  a8 [shape=diamond, label="elabora", margin="0.0,0.0", height=0.45];
  USUARIO -- a8 [label="1", fontsize=12];
  a8 -- ORDEN_COMPRA [label="N", fontsize=12];
  a9 [shape=diamond, label="surte", margin="0.0,0.0", height=0.45];
  PROVEEDOR -- a9 [label="M", fontsize=12];
  a9 -- PRODUCTO [label="N", fontsize=12];
  a10 [shape=ellipse, label="codigo_proveedor", margin="0.01,0.0", height=0.28];
  a9 -- a10;
  a11 [shape=ellipse, label="precio_compra", margin="0.01,0.0", height=0.28];
  a9 -- a11;
  a12 [shape=ellipse, label="moneda", margin="0.01,0.0", height=0.28];
  a9 -- a12;
  a13 [shape=diamond, label="recibe", margin="0.0,0.0", height=0.45];
  PROVEEDOR -- a13 [label="1", fontsize=12];
  a13 -- ORDEN_COMPRA [label="N", fontsize=12];
  a14 [shape=diamond, label="solicita", margin="0.0,0.0", height=0.45];
  ORDEN_COMPRA -- a14 [label="M", fontsize=12];
  a14 -- PRODUCTO [label="N", fontsize=12];
  a15 [shape=ellipse, label="cantidad_solicitada", margin="0.01,0.0", height=0.28];
  a14 -- a15;
  a16 [shape=ellipse, label="cantidad_recibida", margin="0.01,0.0", height=0.28];
  a14 -- a16;
  a17 [shape=ellipse, label="costo_unitario", margin="0.01,0.0", height=0.28];
  a14 -- a17;
  a18 [shape=diamond, label="se surte con", margin="0.0,0.0", height=0.45];
  ORDEN_COMPRA -- a18 [label="1", fontsize=12];
  a18 -- RECEPCION [label="N", fontsize=12];
}