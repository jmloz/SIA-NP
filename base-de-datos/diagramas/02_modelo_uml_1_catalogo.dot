graph uml {
  graph [fontname="Liberation Sans", fontsize=13, bgcolor="white", color="black", fontcolor="black", pad=0.2];
  node  [fontname="Liberation Sans", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Liberation Sans", fontsize=10, color="black", fontcolor="black"];

  graph [rankdir=TB, splines=polyline, nodesep=0.3, ranksep=0.5];
  Familia [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E6E6E6"><B>Familia</B></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">-idFamilia: Integer</TD></TR><TR><TD ALIGN="LEFT">-nombre: String</TD></TR><TR><TD ALIGN="LEFT">-descripcion: String</TD></TR></TABLE></TD></TR><TR><TD HEIGHT="12"> </TD></TR></TABLE>>];
  Ubicacion [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E6E6E6"><B>Ubicacion</B></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">-idUbicacion: Integer</TD></TR><TR><TD ALIGN="LEFT">-clave: String</TD></TR><TR><TD ALIGN="LEFT">-pasillo: char{A,B,C,P}</TD></TR><TR><TD ALIGN="LEFT">-anaquel: Integer</TD></TR><TR><TD ALIGN="LEFT">-nivel: Integer</TD></TR><TR><TD ALIGN="LEFT">-descripcion: String</TD></TR><TR><TD ALIGN="LEFT">-disponible: Boolean=1</TD></TR></TABLE></TD></TR><TR><TD HEIGHT="12"> </TD></TR></TABLE>>];
  Producto [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E6E6E6"><B>Producto</B></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">-idProducto: Integer</TD></TR><TR><TD ALIGN="LEFT">-codigoInterno: String</TD></TR><TR><TD ALIGN="LEFT">-codigoBarras: String</TD></TR><TR><TD ALIGN="LEFT">-descripcion: String</TD></TR><TR><TD ALIGN="LEFT">-unidadMedida: String{PZA,M,KG,LT,JGO,ROLLO}="PZA"</TD></TR><TR><TD ALIGN="LEFT">-minimo: Decimal=0</TD></TR><TR><TD ALIGN="LEFT">-maximo: Decimal=0</TD></TR><TR><TD ALIGN="LEFT">-puntoReorden: Decimal=0</TD></TR><TR><TD ALIGN="LEFT">-existencia: Decimal=0.0</TD></TR><TR><TD ALIGN="LEFT">-costoUnitario: Decimal=0</TD></TR><TR><TD ALIGN="LEFT">-precioVenta: Decimal=0</TD></TR><TR><TD ALIGN="LEFT">-imagenUrl: String</TD></TR><TR><TD ALIGN="LEFT">-activo: Boolean=1</TD></TR><TR><TD ALIGN="LEFT">-fechaAlta: Fecha</TD></TR></TABLE></TD></TR><TR><TD HEIGHT="12"> </TD></TR></TABLE>>];
  InventarioFisico [shape=plaintext, label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>InventarioFisico</B></TD></TR></TABLE>>];
  Movimiento [shape=plaintext, label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B><I>Movimiento</I></B></TD></TR></TABLE>>];
  DetalleConteo [shape=plaintext, label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>DetalleConteo</B></TD></TR></TABLE>>];
  Proveedor [shape=plaintext, label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>Proveedor</B></TD></TR></TABLE>>];
  ProductoProveedor [shape=plaintext, label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>ProductoProveedor</B></TD></TR></TABLE>>];
  OrdenDeCompra [shape=plaintext, label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>OrdenDeCompra</B></TD></TR></TABLE>>];
  DetalleOrden [shape=plaintext, label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>DetalleOrden</B></TD></TR></TABLE>>];
  Familia -- Producto [label=" clasifica ", taillabel="1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  Familia -- InventarioFisico [label=" abarca ", taillabel="0..1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  Ubicacion -- Producto [label=" contiene ", taillabel="0..1", headlabel="0..*", labeldistance=1.8, labelangle=30, dir=back, arrowtail=odiamond, arrowsize=1.4];
  Ubicacion -- Movimiento [label=" ocurre en ", taillabel="1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  Producto -- Movimiento [label=" afecta ", taillabel="1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  DetalleConteo -- Ubicacion [label=" se verifica en ", taillabel="0..*", headlabel="1", labeldistance=1.8, labelangle=30];
  p0 [shape=point, width=0.01, label=""];
  Proveedor -- p0 [taillabel="1..*", labeldistance=1.8, labelangle=30, label=" surte "];
  p0 -- Producto [headlabel="1..*", labeldistance=1.8, labelangle=30];
  ProductoProveedor -- p0 [style=dashed];
  p1 [shape=point, width=0.01, label=""];
  OrdenDeCompra -- p1 [taillabel="0..*", labeldistance=1.8, labelangle=30, label=" solicita "];
  p1 -- Producto [headlabel="1..*", labeldistance=1.8, labelangle=30];
  DetalleOrden -- p1 [style=dashed];
  p2 [shape=point, width=0.01, label=""];
  InventarioFisico -- p2 [taillabel="0..*", labeldistance=1.8, labelangle=30, label=" cuenta "];
  p2 -- Producto [headlabel="1..*", labeldistance=1.8, labelangle=30];
  DetalleConteo -- p2 [style=dashed];
}