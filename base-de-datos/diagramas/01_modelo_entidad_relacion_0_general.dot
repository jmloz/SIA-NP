graph mer {
  graph [fontname="Liberation Sans", fontsize=13, bgcolor="white", color="black", fontcolor="black", pad=0.2];
  node  [fontname="Liberation Sans", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Liberation Sans", fontsize=10, color="black", fontcolor="black"];

  graph [rankdir=TB, splines=true, nodesep=0.3, ranksep=0.45];
  node [fontsize=12];
  ROL [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>ROL</B>>, margin="0.1,0.06"];
  USUARIO [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>USUARIO</B>>, margin="0.1,0.06"];
  BITACORA_AUDITORIA [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>BITACORA_AUDITORIA</B>>, margin="0.1,0.06"];
  FAMILIA [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>FAMILIA</B>>, margin="0.1,0.06"];
  UBICACION [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>UBICACION</B>>, margin="0.1,0.06"];
  PRODUCTO [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>PRODUCTO</B>>, margin="0.1,0.06"];
  PROVEEDOR [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>PROVEEDOR</B>>, margin="0.1,0.06"];
  ORDEN_COMPRA [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>ORDEN_COMPRA</B>>, margin="0.1,0.06"];
  RECEPCION [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>RECEPCION</B>>, margin="0.1,0.06"];
  INVENTARIO_FISICO [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>INVENTARIO_FISICO</B>>, margin="0.1,0.06"];
  DETALLE_CONTEO [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>DETALLE_CONTEO</B>>, margin="0.1,0.06", peripheries=2];
  MOVIMIENTO [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>MOVIMIENTO</B>>, margin="0.1,0.06"];
  a1 [shape=diamond, label="asigna", margin="0.0,0.0", height=0.45];
  ROL -- a1 [label="1", fontsize=12];
  a1 -- USUARIO [label="N", fontsize=12];
  a2 [shape=diamond, label="genera", margin="0.0,0.0", height=0.45];
  USUARIO -- a2 [label="1", fontsize=12];
  a2 -- BITACORA_AUDITORIA [label="N", fontsize=12];
  a3 [shape=diamond, label="registra", margin="0.0,0.0", height=0.45];
  USUARIO -- a3 [label="1", fontsize=12];
  a3 -- MOVIMIENTO [label="N", fontsize=12];
  a4 [shape=diamond, label="elabora", margin="0.0,0.0", height=0.45];
  USUARIO -- a4 [label="1", fontsize=12];
  a4 -- ORDEN_COMPRA [label="N", fontsize=12];
  a5 [shape=diamond, label="captura", margin="0.0,0.0", height=0.45];
  USUARIO -- a5 [label="1", fontsize=12];
  a5 -- RECEPCION [label="N", fontsize=12];
  a6 [shape=diamond, label="realiza", margin="0.0,0.0", height=0.45];
  USUARIO -- a6 [label="1", fontsize=12];
  a6 -- INVENTARIO_FISICO [label="N", fontsize=12];
  a7 [shape=diamond, label="clasifica", margin="0.0,0.0", height=0.45];
  FAMILIA -- a7 [label="1", fontsize=12];
  a7 -- PRODUCTO [label="N", fontsize=12];
  a8 [shape=diamond, label="abarca", margin="0.0,0.0", height=0.45];
  FAMILIA -- a8 [label="1", fontsize=12];
  a8 -- INVENTARIO_FISICO [label="N", fontsize=12];
  a9 [shape=diamond, label="contiene", margin="0.0,0.0", height=0.45];
  UBICACION -- a9 [label="1", fontsize=12];
  a9 -- PRODUCTO [label="N", fontsize=12];
  a10 [shape=diamond, label="ocurre en", margin="0.0,0.0", height=0.45];
  UBICACION -- a10 [label="1", fontsize=12];
  a10 -- MOVIMIENTO [label="N", fontsize=12];
  a11 [shape=diamond, label="afecta", margin="0.0,0.0", height=0.45];
  PRODUCTO -- a11 [label="1", fontsize=12];
  a11 -- MOVIMIENTO [label="N", fontsize=12];
  a12 [shape=diamond, label="surte", margin="0.0,0.0", height=0.45];
  PROVEEDOR -- a12 [label="M", fontsize=12];
  a12 -- PRODUCTO [label="N", fontsize=12];
  a13 [shape=diamond, label="recibe", margin="0.0,0.0", height=0.45];
  PROVEEDOR -- a13 [label="1", fontsize=12];
  a13 -- ORDEN_COMPRA [label="N", fontsize=12];
  a14 [shape=diamond, label="solicita", margin="0.0,0.0", height=0.45];
  ORDEN_COMPRA -- a14 [label="M", fontsize=12];
  a14 -- PRODUCTO [label="N", fontsize=12];
  a15 [shape=diamond, label="se surte con", margin="0.0,0.0", height=0.45];
  ORDEN_COMPRA -- a15 [label="1", fontsize=12];
  a15 -- RECEPCION [label="N", fontsize=12];
  a16 [shape=diamond, label="genera", margin="0.0,0.0", height=0.45];
  RECEPCION -- a16 [label="1", fontsize=12];
  a16 -- MOVIMIENTO [label="N", fontsize=12];
  a17 [shape=diamond, label="origina", margin="0.0,0.0", height=0.45];
  INVENTARIO_FISICO -- a17 [label="1", fontsize=12];
  a17 -- MOVIMIENTO [label="N", fontsize=12];
  a18 [shape=diamond, label="incluye", margin="0.0,0.0", height=0.45, peripheries=2];
  INVENTARIO_FISICO -- a18 [label="1", fontsize=12];
  a18 -- DETALLE_CONTEO [label="N", fontsize=12];
  a19 [shape=diamond, label="se cuenta en", margin="0.0,0.0", height=0.45, peripheries=2];
  PRODUCTO -- a19 [label="1", fontsize=12];
  a19 -- DETALLE_CONTEO [label="N", fontsize=12];
  a20 [shape=diamond, label="se verifica en", margin="0.0,0.0", height=0.45];
  UBICACION -- a20 [label="1", fontsize=12];
  a20 -- DETALLE_CONTEO [label="N", fontsize=12];
  esp [shape=circle, label="d", width=0.35, fixedsize=true];
  MOVIMIENTO -- esp [color="black:white:black", label="tipo"];
  ENTRADA [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>ENTRADA</B>>];
  esp -- ENTRADA;
  SALIDA [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>SALIDA</B>>];
  esp -- SALIDA;
  AJUSTE [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>AJUSTE</B>>];
  esp -- AJUSTE;
  DEVOLUCION [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>DEVOLUCION</B>>];
  esp -- DEVOLUCION;
}