digraph logico {
  graph [fontname="Liberation Sans", fontsize=13, bgcolor="white", color="black", fontcolor="black", pad=0.2];
  node  [fontname="Liberation Sans", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Liberation Sans", fontsize=10, color="black", fontcolor="black"];

  graph [rankdir=LR, splines=polyline, nodesep=0.35, ranksep=0.9];
  RECEPCION [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>RECEPCION</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_recepcion</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT"><B>folio</B></TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT"><B>id_oc</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>fecha_recepcion</B></TD><TD ALIGN="LEFT">DATETIME2(0)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>numero_factura</B></TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>tipo_recepcion</B></TD><TD ALIGN="LEFT">CHAR(1)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">observaciones</TD><TD ALIGN="LEFT">VARCHAR(250)</TD></TR></TABLE>>];
  INVENTARIO_FISICO [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>INVENTARIO_FISICO</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_conteo</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT"><B>folio</B></TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>tipo_conteo</B></TD><TD ALIGN="LEFT">CHAR(1)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_familia</TD><TD ALIGN="LEFT">SMALLINT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>fecha</B></TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>estado</B></TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR></TABLE>>];
  DETALLE_CONTEO [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>DETALLE_CONTEO</B></TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT"><B>id_conteo</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT"><B>id_producto</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT"><B>id_ubicacion</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>existencia_sistema</B></TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>cantidad_contada</B></TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">diferencia</TD><TD ALIGN="LEFT">DECIMAL(10,2) calc.</TD></TR></TABLE>>];
  MOVIMIENTO [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>MOVIMIENTO</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_movimiento</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT"><B>folio</B></TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>tipo</B></TD><TD ALIGN="LEFT">CHAR(1)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>fecha</B></TD><TD ALIGN="LEFT">DATETIME2(0)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT"><B>id_producto</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT"><B>id_ubicacion</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>cantidad</B></TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>saldo_resultante</B></TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">documento_ref</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_recepcion</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_conteo</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">motivo</TD><TD ALIGN="LEFT">VARCHAR(200)</TD></TR></TABLE>>];
  PRODUCTO [shape=plaintext, label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>PRODUCTO</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_producto</B></TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
  UBICACION [shape=plaintext, label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>UBICACION</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_ubicacion</B></TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
  FAMILIA [shape=plaintext, label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>FAMILIA</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_familia</B></TD><TD ALIGN="LEFT">SMALLINT</TD></TR></TABLE>>];
  USUARIO [shape=plaintext, label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>USUARIO</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
  ORDEN_COMPRA [shape=plaintext, label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>ORDEN_COMPRA</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_oc</B></TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
  INVENTARIO_FISICO -> DETALLE_CONTEO [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_conteo ", fontsize=9];
  PRODUCTO -> DETALLE_CONTEO [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_producto ", fontsize=9];
  UBICACION -> DETALLE_CONTEO [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_ubicacion ", fontsize=9];
  FAMILIA -> INVENTARIO_FISICO [dir=both, arrowhead=crowodot, arrowtail=teeodot, arrowsize=1.0, label=" id_familia ", fontsize=9];
  USUARIO -> INVENTARIO_FISICO [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_usuario ", fontsize=9];
  PRODUCTO -> MOVIMIENTO [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_producto ", fontsize=9];
  UBICACION -> MOVIMIENTO [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_ubicacion ", fontsize=9];
  USUARIO -> MOVIMIENTO [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_usuario ", fontsize=9];
  RECEPCION -> MOVIMIENTO [dir=both, arrowhead=crowodot, arrowtail=teeodot, arrowsize=1.0, label=" id_recepcion ", fontsize=9];
  INVENTARIO_FISICO -> MOVIMIENTO [dir=both, arrowhead=crowodot, arrowtail=teeodot, arrowsize=1.0, label=" id_conteo ", fontsize=9];
  ORDEN_COMPRA -> RECEPCION [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_oc ", fontsize=9];
  USUARIO -> RECEPCION [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_usuario ", fontsize=9];
}