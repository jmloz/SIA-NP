graph uml {
  graph [fontname="Liberation Sans", fontsize=13, bgcolor="white", color="black", fontcolor="black", pad=0.2];
  node  [fontname="Liberation Sans", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Liberation Sans", fontsize=10, color="black", fontcolor="black"];

  graph [rankdir=TB, splines=polyline, nodesep=0.3, ranksep=0.5];
  Rol [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>Rol</B></TD></TR></TABLE>>];
  Usuario [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>Usuario</B></TD></TR></TABLE>>];
  BitacoraAuditoria [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>BitacoraAuditoria</B></TD></TR></TABLE>>];
  Familia [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>Familia</B></TD></TR></TABLE>>];
  Ubicacion [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>Ubicacion</B></TD></TR></TABLE>>];
  Producto [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>Producto</B></TD></TR></TABLE>>];
  Proveedor [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>Proveedor</B></TD></TR></TABLE>>];
  ProductoProveedor [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>ProductoProveedor</B></TD></TR></TABLE>>];
  OrdenDeCompra [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>OrdenDeCompra</B></TD></TR></TABLE>>];
  DetalleOrden [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>DetalleOrden</B></TD></TR></TABLE>>];
  Recepcion [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>Recepcion</B></TD></TR></TABLE>>];
  InventarioFisico [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>InventarioFisico</B></TD></TR></TABLE>>];
  DetalleConteo [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>DetalleConteo</B></TD></TR></TABLE>>];
  Movimiento [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B><I>Movimiento</I></B></TD></TR></TABLE>>];
  Entrada [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>Entrada</B></TD></TR></TABLE>>];
  Salida [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>Salida</B></TD></TR></TABLE>>];
  Ajuste [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>Ajuste</B></TD></TR></TABLE>>];
  Devolucion [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E6E6E6"><B>Devolucion</B></TD></TR></TABLE>>];
  Movimiento -- Entrada [dir=back, arrowtail=empty, arrowsize=1.5, sametail=gen];
  Movimiento -- Salida [dir=back, arrowtail=empty, arrowsize=1.5, sametail=gen];
  Movimiento -- Ajuste [dir=back, arrowtail=empty, arrowsize=1.5, sametail=gen];
  Movimiento -- Devolucion [dir=back, arrowtail=empty, arrowsize=1.5, sametail=gen];
  Rol -- Usuario [label=" asigna ", taillabel="1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  Usuario -- BitacoraAuditoria [label=" genera ", taillabel="1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  Usuario -- Movimiento [label=" registra ", taillabel="1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  Usuario -- OrdenDeCompra [label=" elabora ", taillabel="1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  Usuario -- Recepcion [label=" captura ", taillabel="1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  Usuario -- InventarioFisico [label=" realiza ", taillabel="1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  Familia -- Producto [label=" clasifica ", taillabel="1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  Familia -- InventarioFisico [label=" abarca ", taillabel="0..1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  Ubicacion -- Producto [label=" contiene ", taillabel="0..1", headlabel="0..*", labeldistance=1.8, labelangle=30, dir=back, arrowtail=odiamond, arrowsize=1.4];
  Ubicacion -- Movimiento [label=" ocurre en ", taillabel="1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  Producto -- Movimiento [label=" afecta ", taillabel="1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  Proveedor -- OrdenDeCompra [label=" recibe ", taillabel="1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  OrdenDeCompra -- Recepcion [label=" se surte con ", taillabel="1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  Recepcion -- Entrada [label=" genera ", taillabel="0..1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  InventarioFisico -- Ajuste [label=" origina ", taillabel="0..1", headlabel="0..*", labeldistance=1.8, labelangle=30];
  DetalleConteo -- Ubicacion [label=" se verifica en ", taillabel="0..*", headlabel="1", labeldistance=1.8, labelangle=30];
  p0 [shape=point, width=0.01, label=""];
  Proveedor -- p0 [taillabel="1..*", labeldistance=1.8, labelangle=30, label=" surte "];
  p0 -- Producto [headlabel="1..*", labeldistance=1.8, labelangle=30];
  ProductoProveedor -- p0 [style=dashed];
  p1 [shape=point, width=0.01, label=""];
  OrdenDeCompra -- p1 [taillabel="0..*", labeldistance=1.8, labelangle=30, label=" solicita "];
  p1 -- Producto [headlabel="1..*", labeldistance=1.8, labelangle=30];
  DetalleOrden -- p1 [style=dashed];
  p2 [shape=point, width=0.01, label=""];
  InventarioFisico -- p2 [taillabel="0..*", labeldistance=1.8, labelangle=30, label=" cuenta "];
  p2 -- Producto [headlabel="1..*", labeldistance=1.8, labelangle=30];
  DetalleConteo -- p2 [style=dashed];
  { rank=same; Entrada; Salida; Ajuste; Devolucion; }
}