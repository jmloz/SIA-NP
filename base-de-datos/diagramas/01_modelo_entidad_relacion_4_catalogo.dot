graph mer {
  graph [fontname="Liberation Sans", fontsize=13, bgcolor="white", color="black", fontcolor="black", pad=0.2];
  node  [fontname="Liberation Sans", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Liberation Sans", fontsize=10, color="black", fontcolor="black"];

  graph [rankdir=TB, splines=true, nodesep=0.1, ranksep=0.3];
  node [fontsize=12];
  USUARIO [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>USUARIO</B>>, margin="0.1,0.06"];
  FAMILIA [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>FAMILIA</B>>, margin="0.1,0.06"];
  UBICACION [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>UBICACION</B>>, margin="0.1,0.06"];
  PRODUCTO [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>PRODUCTO</B>>, margin="0.1,0.06"];
  ORDEN_COMPRA [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>ORDEN_COMPRA</B>>, margin="0.1,0.06"];
  RECEPCION [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>RECEPCION</B>>, margin="0.1,0.06"];
  INVENTARIO_FISICO [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>INVENTARIO_FISICO</B>>, margin="0.1,0.06"];
  DETALLE_CONTEO [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>DETALLE_CONTEO</B>>, margin="0.1,0.06", peripheries=2];
  MOVIMIENTO [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>MOVIMIENTO</B>>, margin="0.1,0.06"];
  a1 [shape=ellipse, label=<<U>id_recepcion</U>>, margin="0.01,0.0", height=0.28];
  RECEPCION -- a1;
  a2 [shape=ellipse, label=<folio>, margin="0.01,0.0", height=0.28];
  RECEPCION -- a2;
  a3 [shape=ellipse, label=<numero_factura>, margin="0.01,0.0", height=0.28];
  RECEPCION -- a3;
  a4 [shape=ellipse, label=<<U>id_conteo</U>>, margin="0.01,0.0", height=0.28];
  INVENTARIO_FISICO -- a4;
  a5 [shape=ellipse, label=<folio>, margin="0.01,0.0", height=0.28];
  INVENTARIO_FISICO -- a5;
  a6 [shape=ellipse, label=<tipo_conteo>, margin="0.01,0.0", height=0.28];
  INVENTARIO_FISICO -- a6;
  a7 [shape=ellipse, label=<cantidad_contada>, margin="0.01,0.0", height=0.28];
  DETALLE_CONTEO -- a7;
  a8 [shape=ellipse, label=<diferencia>, margin="0.01,0.0", height=0.28, style=dashed];
  DETALLE_CONTEO -- a8;
  a9 [shape=ellipse, label=<<U>id_movimiento</U>>, margin="0.01,0.0", height=0.28];
  MOVIMIENTO -- a9;
  a10 [shape=ellipse, label=<tipo>, margin="0.01,0.0", height=0.28];
  MOVIMIENTO -- a10;
  a11 [shape=ellipse, label=<cantidad>, margin="0.01,0.0", height=0.28];
  MOVIMIENTO -- a11;
  a12 [shape=ellipse, label=<fecha>, margin="0.01,0.0", height=0.28];
  MOVIMIENTO -- a12;
  a13 [shape=diamond, label="registra", margin="0.0,0.0", height=0.45];
  USUARIO -- a13 [label="1", fontsize=12];
  a13 -- MOVIMIENTO [label="N", fontsize=12];
  a14 [shape=diamond, label="captura", margin="0.0,0.0", height=0.45];
  USUARIO -- a14 [label="1", fontsize=12];
  a14 -- RECEPCION [label="N", fontsize=12];
  a15 [shape=diamond, label="realiza", margin="0.0,0.0", height=0.45];
  USUARIO -- a15 [label="1", fontsize=12];
  a15 -- INVENTARIO_FISICO [label="N", fontsize=12];
  a16 [shape=diamond, label="abarca", margin="0.0,0.0", height=0.45];
  FAMILIA -- a16 [label="1", fontsize=12];
  a16 -- INVENTARIO_FISICO [label="N", fontsize=12];
  a17 [shape=diamond, label="ocurre en", margin="0.0,0.0", height=0.45];
  UBICACION -- a17 [label="1", fontsize=12];
  a17 -- MOVIMIENTO [label="N", fontsize=12];
  a18 [shape=diamond, label="afecta", margin="0.0,0.0", height=0.45];
  PRODUCTO -- a18 [label="1", fontsize=12];
  a18 -- MOVIMIENTO [label="N", fontsize=12];
  a19 [shape=diamond, label="se surte con", margin="0.0,0.0", height=0.45];
  ORDEN_COMPRA -- a19 [label="1", fontsize=12];
  a19 -- RECEPCION [label="N", fontsize=12];
  a20 [shape=diamond, label="genera", margin="0.0,0.0", height=0.45];
  RECEPCION -- a20 [label="1", fontsize=12];
  a20 -- MOVIMIENTO [label="N", fontsize=12];
  a21 [shape=diamond, label="origina", margin="0.0,0.0", height=0.45];
  INVENTARIO_FISICO -- a21 [label="1", fontsize=12];
  a21 -- MOVIMIENTO [label="N", fontsize=12];
  a22 [shape=diamond, label="incluye", margin="0.0,0.0", height=0.45, peripheries=2];
  INVENTARIO_FISICO -- a22 [label="1", fontsize=12];
  a22 -- DETALLE_CONTEO [label="N", fontsize=12];
  a23 [shape=diamond, label="se cuenta en", margin="0.0,0.0", height=0.45, peripheries=2];
  PRODUCTO -- a23 [label="1", fontsize=12];
  a23 -- DETALLE_CONTEO [label="N", fontsize=12];
  a24 [shape=diamond, label="se verifica en", margin="0.0,0.0", height=0.45];
  UBICACION -- a24 [label="1", fontsize=12];
  a24 -- DETALLE_CONTEO [label="N", fontsize=12];
  esp [shape=circle, label="d", width=0.35, fixedsize=true];
  MOVIMIENTO -- esp [color="black:white:black", label="tipo"];
  ENTRADA [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>ENTRADA</B>>];
  esp -- ENTRADA;
  SALIDA [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>SALIDA</B>>];
  esp -- SALIDA;
  AJUSTE [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>AJUSTE</B>>];
  esp -- AJUSTE;
  DEVOLUCION [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>DEVOLUCION</B>>];
  esp -- DEVOLUCION;
}