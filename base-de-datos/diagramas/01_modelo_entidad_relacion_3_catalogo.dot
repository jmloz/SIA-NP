graph mer {
  graph [fontname="Liberation Sans", fontsize=13, bgcolor="white", color="black", fontcolor="black", pad=0.2];
  node  [fontname="Liberation Sans", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Liberation Sans", fontsize=10, color="black", fontcolor="black"];

  graph [rankdir=TB, splines=true, nodesep=0.1, ranksep=0.3];
  node [fontsize=12];
  ROL [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>ROL</B>>, margin="0.1,0.06"];
  USUARIO [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>USUARIO</B>>, margin="0.1,0.06"];
  BITACORA_AUDITORIA [shape=box, style=filled, fillcolor="#E6E6E6", label=<<B>BITACORA_AUDITORIA</B>>, margin="0.1,0.06"];
  ORDEN_COMPRA [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>ORDEN_COMPRA</B>>, margin="0.1,0.06"];
  RECEPCION [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>RECEPCION</B>>, margin="0.1,0.06"];
  INVENTARIO_FISICO [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>INVENTARIO_FISICO</B>>, margin="0.1,0.06"];
  MOVIMIENTO [shape=box, style="filled,dashed", fillcolor="#E6E6E6", label=<<B>MOVIMIENTO</B>>, margin="0.1,0.06"];
  a1 [shape=ellipse, label=<<U>id_rol</U>>, margin="0.01,0.0", height=0.28];
  ROL -- a1;
  a2 [shape=ellipse, label=<clave>, margin="0.01,0.0", height=0.28];
  ROL -- a2;
  a3 [shape=ellipse, label=<nombre>, margin="0.01,0.0", height=0.28];
  ROL -- a3;
  a4 [shape=ellipse, label=<<U>id_usuario</U>>, margin="0.01,0.0", height=0.28];
  USUARIO -- a4;
  a5 [shape=ellipse, label=<nombre_usuario>, margin="0.01,0.0", height=0.28];
  USUARIO -- a5;
  a6 [shape=ellipse, label=<nombre_completo>, margin="0.01,0.0", height=0.28];
  USUARIO -- a6;
  a7 [shape=ellipse, label=<<U>id_registro</U>>, margin="0.01,0.0", height=0.28];
  BITACORA_AUDITORIA -- a7;
  a8 [shape=ellipse, label=<fecha_hora>, margin="0.01,0.0", height=0.28];
  BITACORA_AUDITORIA -- a8;
  a9 [shape=ellipse, label=<accion>, margin="0.01,0.0", height=0.28];
  BITACORA_AUDITORIA -- a9;
  a10 [shape=diamond, label="asigna", margin="0.0,0.0", height=0.45];
  ROL -- a10 [label="1", fontsize=12];
  a10 -- USUARIO [label="N", fontsize=12];
  a11 [shape=diamond, label="genera", margin="0.0,0.0", height=0.45];
  USUARIO -- a11 [label="1", fontsize=12];
  a11 -- BITACORA_AUDITORIA [label="N", fontsize=12];
  a12 [shape=diamond, label="registra", margin="0.0,0.0", height=0.45];
  USUARIO -- a12 [label="1", fontsize=12];
  a12 -- MOVIMIENTO [label="N", fontsize=12];
  a13 [shape=diamond, label="elabora", margin="0.0,0.0", height=0.45];
  USUARIO -- a13 [label="1", fontsize=12];
  a13 -- ORDEN_COMPRA [label="N", fontsize=12];
  a14 [shape=diamond, label="captura", margin="0.0,0.0", height=0.45];
  USUARIO -- a14 [label="1", fontsize=12];
  a14 -- RECEPCION [label="N", fontsize=12];
  a15 [shape=diamond, label="realiza", margin="0.0,0.0", height=0.45];
  USUARIO -- a15 [label="1", fontsize=12];
  a15 -- INVENTARIO_FISICO [label="N", fontsize=12];
}