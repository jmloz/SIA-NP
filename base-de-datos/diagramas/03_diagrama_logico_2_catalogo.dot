digraph logico {
  graph [fontname="Liberation Sans", fontsize=13, bgcolor="white", color="black", fontcolor="black", pad=0.2];
  node  [fontname="Liberation Sans", fontsize=11, color="black", fontcolor="black"];
  edge  [fontname="Liberation Sans", fontsize=10, color="black", fontcolor="black"];

  graph [rankdir=LR, splines=polyline, nodesep=0.35, ranksep=0.9];
  PROVEEDOR [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>PROVEEDOR</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_proveedor</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT"><B>rfc</B></TD><TD ALIGN="LEFT">VARCHAR(13)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>razon_social</B></TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>clasificacion</B></TD><TD ALIGN="LEFT">VARCHAR(11)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">nombre_contacto</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">telefono</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">correo</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>lead_time_dias</B></TD><TD ALIGN="LEFT">SMALLINT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>activo</B></TD><TD ALIGN="LEFT">BIT</TD></TR></TABLE>>];
  PRODUCTO_PROVEEDOR [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>PRODUCTO_PROVEEDOR</B></TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT"><B>id_producto</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT"><B>id_proveedor</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">codigo_proveedor</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>precio_compra</B></TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>moneda</B></TD><TD ALIGN="LEFT">CHAR(3)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>fecha_actualizacion</B></TD><TD ALIGN="LEFT">DATE</TD></TR></TABLE>>];
  ORDEN_COMPRA [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>ORDEN_COMPRA</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_oc</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT"><B>folio</B></TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT"><B>id_proveedor</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>fecha_emision</B></TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">fecha_entrega_estimada</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>estado</B></TD><TD ALIGN="LEFT">VARCHAR(16)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>subtotal</B></TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">iva</TD><TD ALIGN="LEFT">DECIMAL(12,2) calc.</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">total</TD><TD ALIGN="LEFT">DECIMAL(12,2) calc.</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">observaciones</TD><TD ALIGN="LEFT">VARCHAR(250)</TD></TR></TABLE>>];
  DETALLE_ORDEN [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>DETALLE_ORDEN</B></TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT"><B>id_oc</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT"><B>id_producto</B></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>cantidad_solicitada</B></TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>cantidad_recibida</B></TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>costo_unitario</B></TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">importe</TD><TD ALIGN="LEFT">DECIMAL(14,2) calc.</TD></TR></TABLE>>];
  PRODUCTO [shape=plaintext, label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>PRODUCTO</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_producto</B></TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
  USUARIO [shape=plaintext, label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#E6E6E6" BORDER="1" SIDES="B"><B>USUARIO</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
  ORDEN_COMPRA -> DETALLE_ORDEN [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_oc ", fontsize=9];
  PRODUCTO -> DETALLE_ORDEN [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_producto ", fontsize=9];
  PROVEEDOR -> ORDEN_COMPRA [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_proveedor ", fontsize=9];
  USUARIO -> ORDEN_COMPRA [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_usuario ", fontsize=9];
  PRODUCTO -> PRODUCTO_PROVEEDOR [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_producto ", fontsize=9];
  PROVEEDOR -> PRODUCTO_PROVEEDOR [dir=both, arrowhead=crowodot, arrowtail=teetee, arrowsize=1.0, label=" id_proveedor ", fontsize=9];
}